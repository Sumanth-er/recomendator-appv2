# Copy to .env and fill in. .env is gitignored - keep it that way, the database
# password is in here in plain text.
#
# Nothing loads this file automatically: config.py reads os.getenv, so the
# variables have to be in the environment before the process starts. Either
#
#   set -a; . ./.env; set +a          # then run uvicorn in that shell
#   docker run --env-file .env ...    # for the backend container
#
# Do not put a comment on the same line as a value. --env-file has no quoting
# rules and would read "eu  # the comment" as the value.

# ---------------------------------------------------------------------------
# Backend - required
# ---------------------------------------------------------------------------

# Project id. Storage, Document AI and Vertex all use it, and the agent's
# GOOGLE_CLOUD_PROJECT is derived from it at start-up.
GCP_PROJECT=my-project

# Bucket name only. No gs:// prefix.
GCS_BUCKET=my-project-quote-poc

# The processor id only, not the full projects/.../processors/... path.
DOCAI_PROCESSOR_ID=abc123def456

# Must match the processor's own region - eu or us. A mismatch gives a 404 that
# does not mention the region.
DOCAI_LOCATION=eu

# ---------------------------------------------------------------------------
# Backend - database
# ---------------------------------------------------------------------------
#
# Three ways to point at a database, in the order config.py checks them:
#
#   1. DATABASE_URL          - wins over everything below
#   2. INSTANCE_CONNECTION_NAME - Cloud Run's unix socket to Cloud SQL
#   3. neither               - falls back to sqlite at ./quotepoc.db
#
# For local work, leave all three unset and you get SQLite with no setup.

# project:region:instance, from the Cloud SQL overview page.
#INSTANCE_CONNECTION_NAME=my-project:europe-west3:quote-poc-db
#DB_USER=postgres
#DB_PASSWORD=
#DB_NAME=quotepoc

# Full SQLAlchemy URL. Overrides every DB_* and INSTANCE_CONNECTION_NAME above.
# Useful against a local Postgres or the Cloud SQL Auth Proxy on 5432.
#DATABASE_URL=postgresql+pg8000://postgres:password@localhost:5432/quotepoc

# ---------------------------------------------------------------------------
# Backend - Vertex AI
# ---------------------------------------------------------------------------

# Gemini availability is region specific; global is served everywhere. If you
# change it, check the model is offered in that region or the agent 404s.
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash

# Derived from GCP_PROJECT and VERTEX_LOCATION on start-up - the ADK reads these
# names rather than ours, and answers every question from the stored trail if
# they are missing. Set them only to point the agent at a different project or
# region than Document AI and Storage use.
#GOOGLE_GENAI_USE_VERTEXAI=TRUE
#GOOGLE_CLOUD_PROJECT=my-project
#GOOGLE_CLOUD_LOCATION=global

# ---------------------------------------------------------------------------
# Backend - local convenience
# ---------------------------------------------------------------------------

# Serve the frontend from the same process, so the whole POC runs with one
# command. Stays off in Cloud Run, where the frontend is its own container.
#SERVE_FRONTEND=1

# Cloud Run sets this itself. Only useful locally.
#PORT=8080

# ---------------------------------------------------------------------------
# Frontend container
# ---------------------------------------------------------------------------

# The backend's URL, for the nginx container only. No trailing slash and no
# /api - nginx appends the path. Not read by the backend.
#BACKEND_URL=https://quote-backend-xxxx.a.run.app
