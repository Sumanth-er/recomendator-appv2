# Copy to .env and fill in. .env is gitignored - keep it that way.
#
# Nothing loads this file automatically. Either:
#   set -a; . ./.env; set +a          # then run uvicorn in that shell
#   docker run --env-file .env ...    # for the backend container
#
# Never put a comment on the same line as a value. --env-file has no quoting
# rules and would read "eu  # note" as the value, comment included.
#
# Full reference, including the Cloud Run settings: infra/ENV.md


# --- required ---------------------------------------------------------------

# Project id. Storage, Document AI, Vertex and Cloud Trace all use it.
GCP_PROJECT=my-project

# Bucket name only, no gs:// prefix.
GCS_BUCKET=my-project-quote-poc

# The processor id only, not the full projects/.../processors/... path.
DOCAI_PROCESSOR_ID=abc123def456

# Must match the processor's own region, eu or us.
DOCAI_LOCATION=eu


# --- site identity ----------------------------------------------------------

# Printed on the approval package as the delivery destination. Left unset the
# package omits that clause, so no site name ships inside the image.
#PLANT_NAME=


# --- database ---------------------------------------------------------------
#
# Checked in order: DATABASE_URL, then INSTANCE_CONNECTION_NAME, then SQLite.
# Local dev needs none of them. On Cloud Run one of the first two is required -
# the SQLite fallback lives in the container and is lost on every revision.

#INSTANCE_CONNECTION_NAME=my-project:europe-west3:quote-poc-db
#DB_PASSWORD=
#DB_USER=postgres
#DB_NAME=quotepoc
#DATABASE_URL=postgresql+pg8000://postgres:password@localhost:5432/quotepoc


# --- Vertex AI --------------------------------------------------------------

# global is served everywhere; other regions may not offer the model.
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash

# How long the agent gets before the deterministic answer is used instead.
# Keep it well under the nginx proxy timeout (300s) and the Cloud Run request
# timeout, or a stalled agent hangs until one of them cuts the connection and
# the browser shows "Failed to fetch" with no answer at all.
#AGENT_TIMEOUT_SECONDS=120

# Derived from the two above at start-up. ADK reads these names rather than
# ours, and without them it targets the Gemini Developer API and fails. Set
# them only to point the agent at a different project or region.
#GOOGLE_GENAI_USE_VERTEXAI=TRUE
#GOOGLE_CLOUD_PROJECT=my-project
#GOOGLE_CLOUD_LOCATION=global


# --- telemetry --------------------------------------------------------------
#
# All optional. Traces go to Cloud Trace, logs to stdout as JSON carrying the
# trace id. Needs roles/cloudtrace.agent. If the exporter cannot be built the
# app still serves and GET /healthz says why.
#
# OTEL_DISABLED=1 turns it off entirely - no exporter, nothing instrumented.
# OTEL_LOGS_EXPORT=1 duplicates every stdout line into the Logging API.

#OTEL_DISABLED=0
#TRACE_SAMPLING_RATIO=1.0
#LOG_LEVEL=INFO
#OTEL_SERVICE_NAME=sourcing-agent-backend
#OTEL_LOGS_EXPORT=0

# Prompt and response capture on the agent's spans. Which variable applies
# depends on the semconv opt-in: with it set, the third is read and only
# SPAN_ONLY / EVENT_ONLY / SPAN_AND_EVENT work - "true" captures nothing.
#ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true
#OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
#OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY


# --- local convenience ------------------------------------------------------

# Serve the SPA from the same process. Off in Cloud Run, where the frontend is
# its own container.
#SERVE_FRONTEND=1

# Cloud Run sets this itself.
#PORT=8080


# --- frontend container -----------------------------------------------------

# Required on the frontend service. No trailing slash and no /api.
#BACKEND_URL=https://quote-backend-xxxx.a.run.app
